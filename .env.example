POSTGRES_DB=zpantry
POSTGRES_USER=zpantry
POSTGRES_PASSWORD=change-me

ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=zpantry;Username=zpantry;Password=change-me
AI_SERVICE_URL=http://localhost:8000
BootstrapReembedEmbeddingsEnabled=false
Gmail__EmailAddress=
Gmail__DisplayName=ZPantry
Gmail__Password=
Gmail__Host=smtp.gmail.com
Gmail__Port=587
Gmail__EnableSsl=true

Jwt__Issuer=ZPantry
Jwt__Audience=ZPantryClient
Jwt__SecretKey=change-me-to-a-random-secret-at-least-32-characters
Jwt__AccessTokenMinutes=60
Jwt__RefreshTokenDays=7

DemoAccounts__0__Email=admin.demo@zpantry.local
DemoAccounts__0__Password=Admin@123456
DemoAccounts__0__FullName=Demo Admin
DemoAccounts__0__Role=admin

DemoAccounts__1__Email=user.demo@zpantry.local
DemoAccounts__1__Password=User@123456
DemoAccounts__1__FullName=Demo User
DemoAccounts__1__Role=user
